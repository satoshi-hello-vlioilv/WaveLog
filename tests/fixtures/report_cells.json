      "text": "A=basic.lotNo"
    },
    {
      "why": "縦が1なら`x`を足さない（同じ理由）",
      "cells": [
        {"label": "A", "path": "basic.lotNo", "kind": "value", "span": 2, "rows": 1, "showLabel": true, "align": "", "format": null},
        {"label": "B", "path": "basic.customer", "kind": "value", "span": 2, "rows": 3, "showLabel": true, "align": "", "format": null},
        {"label": "", "path": "", "kind": "blank", "span": 1, "rows": 1, "showLabel": false, "align": "", "format": null}
      ],
      "text": "A=basic.lotNo|2\nB=basic.customer|2x3\n|1"
    },
    {
      "why": "見出しが1つでもあればJSONへ切り替える（行の形では書けない）",
      "cells": [
        {"label": "MIN", "path": "", "kind": "head", "span": 1, "rows": 1, "showLabel": false, "align": "", "format": null}
      ],
      "json": true
    },
    {
      "why": "ラベルを出さないマスもJSON",
      "cells": [
        {"label": "A", "path": "basic.lotNo", "kind": "value", "span": 1, "rows": 1, "showLabel": false, "align": "", "format": null}
      ],
      "json": true
    },
    {
      "why": "寄せだけでもJSON",
      "cells": [
        {"label": "A", "path": "basic.lotNo", "kind": "value", "span": 1, "rows": 1, "showLabel": true, "align": "right", "format": null}
