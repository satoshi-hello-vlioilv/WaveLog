__pycache__/
*.pyc
*.sqlite3
config/local.json
config/local.json.bak
config/local.json.tmp

# 仕掛/品質データのローカル運用(sikalot_source=local)用資材。PCごとの手動配置
# (RNEファイル・SymNaviA.dll・接続パスワードを含むためコミットしない)。
# 詳細はconfig/rne_extract/README.md参照。
config/rne_extract/rne/
config/rne_extract/NAVIAP/
config/rne_extract/symnavim.conf
config/rne_extract/symnavim.def
boot_status.js

# schedule_sync.pyが共有スケジュールDBの隣へ書く実行時ファイル(排他ロック・
# 編集セッション・書込中の一時ファイル)。schedule_share_pathをリポジトリ内へ
# 向けて動かすと出てくる。状態そのものなのでコミットしない。
schedule.lock.json
schedule.sessions.json
*.tmp

# 検証用フィクスチャ(tests/run_all.sh が読む)。*.sqlite3 の除外に対する例外。
# これが無いとクローン直後にテストが走らない=安全網が持ち運べない。
!db/test_fixture/
!db/test_fixture/**/
!db/test_fixture/**/*.sqlite3
!db/test_fixture/*.sqlite3
# 共有スケジュールDBの作業用コピー(ランナーが毎回原本から作り直す)。原本を
# 直接書き換えると、テストを回すたびに追跡ファイルが汚れてしまう。
db/test_fixture/work/
# テスト実行時に出る一時ファイル(tests/*.log・*.png は tests/.gitignore 側)
db/test_fixture/share/schedule.sessions.json
db/test_fixture/share/schedule.lock.json
db/test_fixture/share/*.tmp

# UNCパス(\\server\share\...)はWindows以外だとただのファイル名になるため、
# 本番既定のパス設定のままLinuxで起動するとリポジトリ直下に
# 「\\Nlmsrvngy03\Read\...」という名前のファイルが生まれる。中身は
# 行き場を失った共有スケジュールDBなのでコミットしない。
[\\]*

# 画面キャプチャ(tests/visual/run.sh)。見た目を変えないリファクタリングの
# 前後比較に使う一時成果物で、PNGなので差分が読めずリポジトリも重くなる。
# 撮り直せば同じものが得られるためコミットしない。
tests/visual/shots/

# テストランナーの二重起動防止ロック(実行中のみ存在)
tests/.run_all.lock

# 共有DBの写し(db_mirror。手元の作業用なので共有しない)
db/cache/

# 在席ファイル(§9.272)。端末ごとに1ファイルで、共有の置き場が無いときは
# ここへ落ちる。中身はその端末の状態なので共有しない。
db/presence/

# 実測用に立てる開発サーバーの作業コピー(tests/run_all.sh の work/ と同じ役割)
db/test_fixture/devwork/
.master_snapshot.sqlite3
